{
  "name": "von-cms",
  "private": true,
  "version": "1.28.2",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server *.cjs *.js *.ts",
    "lint:phpstan": "node server/check-quality.cjs phpstan",
    "check:format": "prettier --check .",
    "check:bom": "node server/check-quality.cjs bom",
    "check:quality": "npm run typecheck && npm run lint:phpstan && npm run check:bom && npm run check:format && npm audit && npm run lint",
    "lint:php": "node server/lint-php.cjs",
    "prebuild": "node -e \"const fs=require('fs'); ['dist', 'public/assets'].forEach(d => { if(fs.existsSync(d)) fs.rmSync(d, {recursive:true, force:true}); });\"",
    "build": "vite build",
    "postbuild": "node server/copy-public-to-dist.cjs && node server/copy-theme-manifests.cjs",
    "start:api": "node server/themes-api.cjs",
    "test:integration": "node server/test-integration.cjs",
    "test:admin-navigation": "node server/test-admin-navigation-browser.cjs",
    "test:editor-navigation": "node server/test-admin-navigation-browser.cjs --real-editor",
    "test:ads-workspace": "node server/test-admin-navigation-browser.cjs --ads-workspace",
    "test:calendar": "node server/test-calendar.cjs",
    "test:calendar-browser": "node server/test-admin-navigation-browser.cjs --calendar",
    "check:health": "node server/health-check.cjs",
    "ci:gate": "npm run typecheck && npm run build && npm run test:smoke",
    "preview": "vite preview",
    "test": "npm run test:smoke",
    "test:smoke": "node server/test-integration.cjs"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.5.81",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@types/nprogress": "^0.2.3",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "fflate": "^0.8.3",
    "fs-extra": "^11.4.1",
    "lucide-react": "^1.71.0",
    "multer": "^2.5.0",
    "nprogress": "^0.2.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-gravatar": "^2.6.3",
    "react-hot-toast": "^2.6.1",
    "react-is": "^19.3.1",
    "react-router": "^8.5.1",
    "react-share": "^6.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@prettier/plugin-php": "^0.26.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-gravatar": "^2.6.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.7"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    },
    "rimraf": "^6.0.0",
    "minimatch@^10.2.4": "11.0.3"
  }
}
