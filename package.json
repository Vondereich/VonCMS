{
  "name": "von-cms",
  "private": true,
  "version": "1.27.12",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint:php": "node server/lint-php.cjs",
    "prebuild": "node -e \"const fs=require('fs'); ['dist', 'public/assets'].forEach(d => { if(fs.existsSync(d)) fs.rmSync(d, {recursive:true, force:true}); });\"",
    "build": "vite build",
    "postbuild": "node server/copy-public-to-dist.cjs && node server/copy-theme-manifests.cjs",
    "start:api": "node server/themes-api.cjs",
    "test:integration": "node server/test-integration.cjs",
    "check:health": "node server/health-check.cjs",
    "ci:gate": "npm run typecheck && npm run build && npm run test:smoke",
    "preview": "vite preview",
    "test": "npm run test:smoke",
    "test:smoke": "node server/test-integration.cjs"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.5.6",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/nprogress": "^0.2.3",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "fs-extra": "^11.4.1",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "nprogress": "^0.2.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-gravatar": "^2.6.3",
    "react-hot-toast": "^2.6.1",
    "react-is": "^19.3.1",
    "react-router": "^8.5.0",
    "react-share": "^6.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prettier/plugin-php": "^0.26.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-gravatar": "^2.6.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    },
    "rimraf": "^6.0.0"
  }
}
